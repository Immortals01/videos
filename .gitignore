# Python & virtual environments
__pycache__/
*.py[cod]
.venv/
production/.venv/
projects/*/.venv

# Downloaded ONNX models (re-downloadable via Kokoro / Depth-Anything-V2)
production/models/
projects/*/production/models/

# Intermediate build chunks, scratch logs, and cached depth maps
production/build/
production/scratch/
production/plates/depth/*.npy
projects/*/production/build/
projects/*/production/scratch/
projects/*/production/plates/depth/*.npy

# Large uncompressed WAV stems & mixes (regenerated by src/tts.py & src/audio.py)
production/audio/stems/*.wav
production/audio/mix_premaster.wav
production/audio/mix_final.wav
projects/*/production/audio/stems/*.wav
projects/*/production/audio/mix_premaster.wav
projects/*/production/audio/mix_final.wav

# Final MP4 > 100 MB (exceeds GitHub's 100 MB per-file limit; upload to GitHub Releases or YouTube/Drive instead)
deliverables/*.mp4
projects/*/deliverables/*.mp4
